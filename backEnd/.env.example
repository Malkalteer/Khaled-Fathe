PORT=5000
NODE_ENV=production
# Comma-separated production origins. Localhost ports are allowed by the server for development.
FRONTEND_URL=https://khaled-fathe.vercel.app
# Public site URL used to build sitemap.xml links
SITE_URL=https://khaled-fathe.vercel.app
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=generate-a-long-random-secret-of-at-least-32-chars
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database
# Optional: only if mongodb+srv DNS lookups fail on your network
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_123456
# AI assistant (server-side only — never put this key in the frontend)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
