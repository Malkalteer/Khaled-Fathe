PORT=5000
# Comma-separated production origins. Localhost ports are allowed by the server for development.
FRONTEND_URL=https://your-vercel-domain.vercel.app
JWT_SECRET=generate-a-long-random-secret
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_123456
ADMIN_TOTP_SECRET=BASE32_AUTHENTICATOR_SECRET
